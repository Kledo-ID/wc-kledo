msgstr "Kledo: Koneksi API dinonaktifkan; sinkronisasi tidak dijalankan."

#. translators: %s: transaction type (order/invoice)
#: includes/class-wc-kledo-woocommerce.php:250
#, php-format
msgid "Kledo: %s was already synced; removed stale entry from failed queue."
msgstr "Kledo: %s sudah tersinkron; entri lama dihapus dari antrian gagal."

#. translators: %s: order or invoice
#: includes/class-wc-kledo-woocommerce.php:345
#, php-format
msgid ""
"Kledo: admin manually re-sent %s to Kledo (record was already marked synced;"
