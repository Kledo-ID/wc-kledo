msgstr ""
"Kledo: admin mengirim %s secara manual (pengiriman pertama; sinkronisasi "
"otomatis tetap berdasarkan status pesanan)."

#. translators: 1: transaction type (order/invoice), 2: HTTP status code, 3:
#. API error message
#: includes/class-wc-kledo-woocommerce.php:392
#, php-format
msgid ""
"Kledo: %1$s was rejected by Kledo (HTTP %2$d): %3$s. This will not be "
"retried automatically — correct the data, then resend it from WooCommerce > "
