msgstr "Aktifkan Pembuatan Tagihan"

#. translators: %s: "Completed" order status label (may include <strong>
#. markup).
#: includes/admin/screen/class-wc-kledo-invoice.php:182
#, php-format
msgid "Create new invoice on Kledo when order status is %s."
msgstr "Buat tagihan baru di Kledo ketika status pesanan %s."

#: includes/admin/screen/class-wc-kledo-invoice.php:189
msgid "Invoice Prefix"
msgstr "Awalan Nomor Tagihan"

#: includes/admin/screen/class-wc-kledo-invoice.php:197
msgid "Invoice Status on Created"
msgstr "Status Tagihan Saat Dibuat"

#: includes/admin/screen/class-wc-kledo-invoice.php:202
#: includes/admin/screen/class-wc-kledo-sync.php:353
