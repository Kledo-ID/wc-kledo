msgstr ""
"Kledo: %1$s ditolak oleh Kledo (HTTP %2$d): %3$s. Ini tidak akan dicoba "
"ulang otomatis — perbaiki datanya, lalu kirim ulang dari WooCommerce > Kledo "
"> Status Kledo."

#. translators: 1: transaction type (order/invoice), 2: HTTP status code, 3:
#. API error message
#: includes/class-wc-kledo-woocommerce.php:401
#, php-format
