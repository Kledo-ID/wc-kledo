msgstr "Pilih Gudang"

#: includes/admin/class-wc-kledo-admin.php:473
msgid "The results could not be loaded."
msgstr "Hasil tidak dapat dimuat."

#: includes/admin/class-wc-kledo-admin.php:474
msgid "Loading more results..."
msgstr "Memuat hasil lainnya..."

#: includes/admin/class-wc-kledo-admin.php:475
msgid "No results found"
msgstr "Tidak ada hasil yang ditemukan"

#: includes/admin/class-wc-kledo-admin.php:476
msgid "Loading..."
msgstr "Memuat..."

#: includes/admin/class-wc-kledo-admin.php:477
