msgstr ""
"Kledo: admin mengirim ulang %s secara manual (sudah tersinkron; kemungkinan "
"duplikat di Kledo)."

#. translators: %s: order or invoice
#: includes/class-wc-kledo-woocommerce.php:304
#, php-format
msgid ""
"Kledo: admin manually sent %s to Kledo (first manual push; automatic sync "
